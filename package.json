{
  "name": "rb-poker-coach",
  "version": "0.1.0",
  "private": true,
  "description": "RB Poker Coach: learn No-Limit Texas Hold'em against friendly bots, with a coach. Play money only.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @rb/web",
    "dev:server": "npm run dev -w @rb/server",
    "build": "npm run build -w @rb/web && npm run build -w @rb/server",
    "start": "node apps/server/dist/main.js",
    "docker:up": "docker compose up --build",
    "test": "npm run test -w @rb/web -w @rb/server",
    "test:coverage": "npm run test:coverage -w @rb/web",
    "test:slow": "npm run test:slow -w @rb/web -w @rb/server",
    "e2e": "node scripts/build-if-needed.mjs && npm run e2e -w @rb/web --",
    "typecheck": "npm run typecheck -w @rb/web -w @rb/server",
    "size": "npm run size -w @rb/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.70.1"
  },
  "allowScripts": {
    "@swc/core": false,
    "fsevents": false
  }
}
